{
  "manifest_version": 3,
  "name": "MoeGuard 喵图混淆",
  "version": "3.7.7",
  "description": "Discord 图片上传自动混淆（流光照影）：只有装了本插件的人才能看到原图。轻量、无损、无需密钥，可选只混淆色情图片。",
  "permissions": ["storage", "contextMenus", "downloads", "nativeMessaging"],
  "optional_host_permissions": ["https://*/*"],
  "host_permissions": [
    "https://discord.com/*",
    "https://cdn.discordapp.com/*",
    "https://media.discordapp.net/*",
    "https://*.discordapp.com/*",
    "https://*.discordapp.net/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://discord.com/*"],
      "js": ["src/core.js", "src/review.js", "src/format.js", "src/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://discord.com/*"],
      "js": ["src/core.js", "src/review.js", "src/format.js", "src/content.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "MoeGuard 喵图混淆"
  },
  "options_page": "src/options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/TwemojiMozilla.ttf"
      ],
      "matches": [
        "https://discord.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "111"
}